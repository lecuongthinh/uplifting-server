# Zalo Mini App (developers.zalo.me -> App Uplifting -> App Details)
ZALO_MINI_APP_ID=
ZALO_MINI_APP_SECRET_KEY=

# VN-hosted relay (resolves phone tokens; not deployed yet — see project memory)
RELAY_URL=
RELAY_SHARED_SECRET=

# GHL (LeadConnector) — Private Integration Token for the Uplifting sub-account
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=

# Supabase — shared "growthLEADERs" project, dedicated schema `uplifting_app`
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Session signing
SESSION_JWT_SECRET=

# Content admin page (/admin/content) — password field, same pattern as
# 123gym-server's /admin/checkin-import
CONTENT_ADMIN_SECRET=

PORT=8787

# Zalo OA API (tag/nhắn tin/webhook) — dùng 1 APP RIÊNG trên developers.zalo.me (không dùng chung app
# với Mini App, để webhook không đụng app bên thứ 3 đang dùng OA). App ID/Secret ở đây là của app RIÊNG đó. Refresh token lưu ở GHL
# Custom Value "zalo_oa_refresh_token" (lấy qua /admin/oa/zalo-oauth-start), không để ở env.
ZALO_OA_APP_ID=
ZALO_OA_APP_SECRET=
# OA Secret Key ở trang Webhook của app OA riêng (developers.zalo.me) — KHÁC App Secret. Dùng kiểm tra chữ ký webhook OA.
ZALO_OA_WEBHOOK_SECRET=
# Workflow GHL → POST /webhooks/ghl-oa-tag-sync gửi kèm header x-webhook-secret = giá trị này.
GHL_WEBHOOK_SECRET=
# Công tắc khẩn cấp tắt tặng quà (không cần deploy): true
GIFTS_DISABLED=
# URL công khai của server (dùng dựng callback OAuth). Mặc định lấy từ request.
BACKEND_URL=https://uplifting-server.onrender.com

# Mã xác thực domain của Zalo (developers.zalo.me -> Xác thực domain), cách nhau bằng dấu phẩy,
# mỗi app Zalo dùng domain này 1 mã. Server phục vụ /zalo_verifier<MÃ>.html cho các mã liệt kê ở đây.
ZALO_VERIFIER_CODES=
